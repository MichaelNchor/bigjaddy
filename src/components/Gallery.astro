---
const src = (id: string, w: number) =>
  `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&q=80`;

const shots = [
  { id: "1502635385003-ee1e6a1a742d", w: 1000, h: 1500, cap: "A marquee dressed in white", alt: "An airy white marquee with crystal chandeliers above a candlelit table" },
  { id: "1695281536457-01f9a07c575b", w: 1000, h: 1500, cap: "The couple, the quiet moment", alt: "A bride and groom share a kiss beneath red bougainvillea" },
  { id: "1525441273400-056e9c7517b3", w: 1200, h: 800, cap: "Soft florals on the head table", alt: "A head table dressed with pastel pink and peach roses and tapered candles" },
  { id: "1618999114008-fbf937170cdb", w: 1000, h: 1500, cap: "Dressed for tradition", alt: "A bride in coral beads and a beaded crown beside her groom in warm light" },
  { id: "1655459765544-39065b741a9e", w: 1200, h: 800, cap: "When the floor fills up", alt: "Guests dancing with arms raised in a warmly lit room" },
  { id: "1617813437449-c4f8f233dcd6", w: 1200, h: 800, cap: "Gold, florals and kente", alt: "An elegant table set with tall gold flower stands, white roses, gold chargers and a kente runner under fairy lights" },
];
---

<section id="gallery" class="gallery section">
  <div class="wrap">
    <div class="gallery__head">
      <div>
        <h2 class="gallery__title reveal">A glimpse of grand.</h2>
        <p class="gallery__lede reveal" style="--reveal-delay:80ms">
          Moments from the room, set and ready, and in full swing.
        </p>
      </div>
      <a href="#contact" class="gallery__cta reveal" style="--reveal-delay:140ms">
        Plan yours <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="gallery__masonry">
      {shots.map((s, i) => (
        <figure class="shot reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
          <img
            src={src(s.id, s.w)}
            srcset={`${src(s.id, Math.round(s.w * 0.7))} ${Math.round(s.w * 0.7)}w, ${src(s.id, s.w)} ${s.w}w`}
            sizes="(max-width: 640px) 92vw, (max-width: 980px) 46vw, 31vw"
            alt={s.alt}
            loading="lazy"
            decoding="async"
            width={s.w}
            height={s.h}
          />
          <figcaption>{s.cap}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery {
    background: var(--ivory);
  }
  .gallery__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 1.4rem + 2.5vw, 3.5rem);
  }
  .gallery__title {
    font-size: var(--step-4);
    color: var(--ink);
  }
  .gallery__lede {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: var(--step-1);
  }
  .gallery__cta {
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-600);
    padding-bottom: 0.3rem;
    border-bottom: 1.5px solid var(--gold-400);
    white-space: nowrap;
  }
  .gallery__cta .arrow {
    transition: transform 0.45s var(--ease-out);
    display: inline-block;
  }
  .gallery__cta:hover .arrow {
    transform: translateX(5px);
  }

  .gallery__masonry {
    columns: 3;
    column-gap: clamp(1rem, 0.6rem + 1.2vw, 1.5rem);
  }
  .shot {
    margin: 0 0 clamp(1rem, 0.6rem + 1.2vw, 1.5rem);
    break-inside: avoid;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .shot img {
    width: 100%;
    height: auto;
    transition: transform 0.9s var(--ease-out);
  }
  .shot::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 55%,
      oklch(0.16 0.04 258 / 0.78) 100%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .shot figcaption {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    right: 1.1rem;
    z-index: 2;
    color: var(--on-navy);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-0);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.6s var(--ease-out);
  }
  .shot:hover img {
    transform: scale(1.05);
  }
  .shot:hover::after {
    opacity: 1;
  }
  .shot:hover figcaption {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 980px) {
    .gallery__masonry {
      columns: 2;
    }
  }
  @media (max-width: 600px) {
    .gallery__masonry {
      columns: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot:hover img {
      transform: none;
    }
  }
</style>
