---
/**
 * BIG JADDY mark — the official logo (public/logo.png), transparent PNG.
 * Pairs with the "BIG JADDY / EVENT CENTER" wordmark; the wordmark text color
 * flips (white over the hero, navy on the solid header).
 */
interface Props {
  variant?: "light" | "dark"; // controls only the wordmark text color
  showWordmark?: boolean;
  class?: string;
}
const { variant = "light", showWordmark = true, class: klass = "" } = Astro.props;
---

<a href="#top" class={`logo ${klass}`} data-variant={variant} aria-label="BIG JADDY Event Center, home">
  <img
    class="logo__mark"
    src="/logo.png"
    alt="BIG JADDY Event Center logo"
    width="864"
    height="1000"
    decoding="async"
  />

  {showWordmark && (
    <span class="logo__word">
      <span class="logo__name">BIG JADDY</span>
      <span class="logo__sub">Event Center</span>
    </span>
  )}
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1;
  }
  .logo__mark {
    width: auto;
    height: clamp(2.5rem, 2.1rem + 1.4vw, 3.2rem);
    flex: none;
    filter: drop-shadow(0 4px 12px oklch(0.2 0.04 258 / 0.28));
  }
  .logo__word {
    display: flex;
    flex-direction: column;
    gap: 0.18em;
  }
  .logo__name {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(1rem, 0.92rem + 0.4vw, 1.2rem);
    letter-spacing: 0.02em;
    line-height: 0.95;
    color: var(--on-navy);
    transition: color 0.3s ease;
  }
  .logo[data-variant="light"] .logo__name {
    color: var(--navy-900);
  }
  /* when the fixed header turns solid over light content, flip to ink */
  :global(.site-header.is-solid) .logo__name {
    color: var(--navy-900);
  }
  .logo__sub {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--gold-600);
  }
  :global(.site-header[data-variant="dark"]) .logo__sub {
    color: var(--gold-400);
  }
</style>
