---
import Logo from "./Logo.astro";

const links = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#occasions", label: "Occasions" },
  { href: "#gallery", label: "Gallery" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header" data-variant="dark">
  <div class="site-header__inner wrap">
    <Logo variant="dark" />

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
      <a href="#contact" class="btn btn--gold nav__cta">Book a tour</a>
    </nav>

    <button
      class="nav-toggle"
      aria-label="Toggle menu"
      aria-controls="primary-nav"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: background-color 0.4s ease, box-shadow 0.4s ease,
      backdrop-filter 0.4s ease;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(0.85rem, 0.6rem + 0.8vw, 1.25rem);
  }

  /* solid state when scrolled */
  .site-header.is-solid {
    background: oklch(0.976 0.008 85 / 0.92);
    backdrop-filter: saturate(140%) blur(12px);
    box-shadow: 0 1px 0 var(--line), 0 10px 30px -20px oklch(0.2 0.04 258 / 0.4);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 0.5rem + 2vw, 2.5rem);
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.4rem + 1.6vw, 2rem);
    list-style: none;
    padding: 0;
  }
  .nav a {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--on-navy);
    position: relative;
    padding-block: 0.3rem;
    transition: color 0.25s ease;
  }
  .nav a:not(.btn)::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    background: var(--gold-400);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }
  .nav a:not(.btn):hover::after {
    transform: scaleX(1);
  }

  /* link colors flip when header is solid (light) */
  .site-header.is-solid .nav a:not(.btn) {
    color: var(--ink);
  }
  .site-header.is-solid .nav a:not(.btn):hover {
    color: var(--gold-600);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
  }
  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--on-navy);
    border-radius: 2px;
    transition: transform 0.35s var(--ease-out), opacity 0.25s ease,
      background-color 0.3s ease;
  }
  .site-header.is-solid .nav-toggle span {
    background: var(--ink);
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: flex;
    }
    .nav {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(82vw, 340px);
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 1.75rem;
      padding: 2rem clamp(1.5rem, 5vw, 2.5rem);
      background: var(--navy-900);
      transform: translateX(100%);
      transition: transform 0.5s var(--ease-out);
      box-shadow: -30px 0 60px -30px oklch(0.1 0.03 258 / 0.6);
    }
    .nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
    }
    .nav a:not(.btn) {
      color: var(--on-navy);
      font-size: var(--step-1);
      font-family: var(--font-display);
    }
    .site-header.is-solid .nav a:not(.btn) {
      color: var(--on-navy);
    }
    .nav__cta {
      margin-top: 0.5rem;
    }
    .site-header.nav-open .nav {
      transform: translateX(0);
    }
    /* hamburger -> close */
    .site-header.nav-open .nav-toggle span {
      background: var(--on-navy);
    }
    .site-header.nav-open .nav-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .site-header.nav-open .nav-toggle span:nth-child(2) {
      opacity: 0;
    }
    .site-header.nav-open .nav-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
