---
const base = (id: string) => `https://images.unsplash.com/photo-${id}`;
const src = (id: string, w: number) =>
  `${base(id)}?auto=format&fit=crop&w=${w}&q=80`;

const occasions = [
  {
    id: "1660675133902-acd1b057f75d",
    span: "wide",
    t: "Weddings & Engagements",
    d: "From traditional rites to the white wedding, a setting dressed for the most important yes.",
    alt: "A bride in kente cloth and a gold crown smiles as guests carry gifts beneath a canopy at a Ghanaian traditional wedding",
  },
  {
    id: "1699730164892-d7c433524ff3",
    span: "narrow",
    t: "Parties & Celebrations",
    d: "Birthdays, anniversaries and milestones worth toasting.",
    alt: "Friends raising glasses for a celebratory toast among balloons and falling confetti",
  },
  {
    id: "1540575467063-178a50c2df87",
    span: "narrow",
    t: "Conferences & Seminars",
    d: "Seating, sound and a professional setting for business days.",
    alt: "An attentive audience seated in a darkened conference hall facing the stage",
  },
  {
    id: "1550305080-4e029753abcf",
    span: "wide",
    t: "Church Programs",
    d: "Conventions, thanksgivings and gatherings with room to praise.",
    alt: "A congregation with hands raised in worship, lit by warm stage light",
  },
];
---

<section id="occasions" class="occasions section">
  <div class="wrap">
    <div class="occasions__head">
      <h2 class="occasions__title reveal">Made for every occasion.</h2>
      <p class="occasions__lede reveal" style="--reveal-delay:90ms">
        One room, many kinds of grand. Whatever you are planning, the space and
        the team flex around it.
      </p>
    </div>

    <div class="occasions__grid">
      {occasions.map((o, i) => (
        <article class={`occ occ--${o.span} reveal`} style={`--reveal-delay:${i * 80}ms`}>
          <img
            src={src(o.id, 900)}
            srcset={`${src(o.id, 700)} 700w, ${src(o.id, 1100)} 1100w`}
            sizes="(max-width: 800px) 92vw, 45vw"
            alt={o.alt}
            loading="lazy"
            decoding="async"
            width="1100"
            height="800"
          />
          <div class="occ__overlay"></div>
          <div class="occ__text">
            <h3>{o.t}</h3>
            <p>{o.d}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .occasions {
    background: var(--cream);
  }
  .occasions__head {
    max-width: 60ch;
    margin-bottom: clamp(2.2rem, 1.5rem + 2.5vw, 3.8rem);
  }
  .occasions__title {
    font-size: var(--step-4);
    color: var(--ink);
  }
  .occasions__lede {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: var(--step-1);
  }

  .occasions__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
  }
  .occ {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: clamp(20rem, 16rem + 12vw, 27rem);
    isolation: isolate;
    box-shadow: var(--shadow-soft);
  }
  .occ--wide {
    grid-column: span 7;
  }
  .occ--narrow {
    grid-column: span 5;
  }
  .occ img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.9s var(--ease-out);
  }
  .occ:hover img {
    transform: scale(1.06);
  }
  .occ__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      oklch(0.17 0.04 258 / 0) 30%,
      oklch(0.16 0.04 258 / 0.85) 100%
    );
  }
  .occ__text {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(1.4rem, 1rem + 1.5vw, 2.2rem);
    color: var(--on-navy);
  }
  .occ__text h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    margin-bottom: 0.35rem;
  }
  .occ__text p {
    color: var(--on-navy-soft);
    font-size: var(--step--1);
    max-width: 38ch;
    transform: translateY(6px);
    opacity: 0.85;
    transition: transform 0.6s var(--ease-out), opacity 0.5s ease;
  }
  .occ:hover .occ__text p {
    transform: translateY(0);
    opacity: 1;
  }
  .occ__text h3::after {
    content: "";
    display: block;
    width: 2.4rem;
    height: 2px;
    background: var(--gold-400);
    margin-top: 0.7rem;
    margin-bottom: 0.7rem;
  }

  @media (max-width: 800px) {
    .occ--wide,
    .occ--narrow {
      grid-column: span 12;
    }
    .occ {
      min-height: 18rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .occ:hover img {
      transform: none;
    }
  }
</style>
