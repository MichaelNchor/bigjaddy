---
// NOTE: replace the placeholder phone / WhatsApp / email / hours below with the
// real details. The form composes an email to data-email on submit (no backend
// needed); swap for Formspree/Netlify Forms later if you prefer.
const phoneDisplay = "+233 00 000 0000";
const phoneHref = "tel:+2330000000";
const whatsappHref = "https://wa.me/2330000000";
const email = "hello@bigjaddyent.com";
const mapQuery = "Hof Vilac International School, Achimota, Accra";
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;

const eventTypes = [
  "Wedding or engagement",
  "Party or celebration",
  "Conference or seminar",
  "Church program",
  "Something else",
];
---

<section id="contact" class="contact section">
  <div class="wrap">
    <div class="contact__head reveal">
      <p class="kicker on-navy">Book a tour</p>
      <h2 class="contact__title">Ready to make it <span class="gilt">grand?</span></h2>
      <p class="contact__lede">
        Tell us a little about your day and we will set up a walk-through of the
        space. Or reach us straight away, we answer quickly.
      </p>
    </div>

    <div class="contact__grid">
      <div class="contact__info reveal">
        <ul class="contact__list">
          <li>
            <span class="contact__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-5.4-6.5-10A6.5 6.5 0 0 1 18.5 11c0 4.6-6.5 10-6.5 10Z"/><circle cx="12" cy="11" r="2.4"/></svg>
            </span>
            <div>
              <span class="contact__label">Visit</span>
              Achimota, Kingsby<br />Adjacent Hof Vilac International School, Accra
            </div>
          </li>
          <li>
            <span class="contact__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h3l1.5 4.5L8 11a12 12 0 0 0 5 5l2.5-2.5L20 15v3a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4 6.2 2 2 0 0 1 6 4Z"/></svg>
            </span>
            <div>
              <span class="contact__label">Call or WhatsApp</span>
              <a href={phoneHref}>{phoneDisplay}</a>
            </div>
          </li>
          <li>
            <span class="contact__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6 8.5-6"/></svg>
            </span>
            <div>
              <span class="contact__label">Email</span>
              <a href={`mailto:${email}`}>{email}</a>
            </div>
          </li>
          <li>
            <span class="contact__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
            </span>
            <div>
              <span class="contact__label">Hours</span>
              Mon–Sat, 9am–6pm<br />Sundays by appointment
            </div>
          </li>
        </ul>

        <div class="contact__quick">
          <a href={whatsappHref} class="btn btn--gold" target="_blank" rel="noopener">Chat on WhatsApp</a>
          <a href={phoneHref} class="btn btn--ghost">Call now</a>
        </div>

        <div class="contact__map">
          <iframe
            title="Map to BIG JADDY ENT Event Center, Achimota"
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <form class="contact__form reveal" data-email={email} style="--reveal-delay:120ms">
        <p class="form__intro">Request a tour</p>
        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="phone">Phone / WhatsApp</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
          <div class="field">
            <label for="emailf">Email <span>(optional)</span></label>
            <input id="emailf" name="email" type="email" autocomplete="email" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="type">Type of event</label>
            <select id="type" name="type">
              {eventTypes.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="date">Preferred date</label>
            <input id="date" name="date" type="date" />
          </div>
        </div>
        <div class="field">
          <label for="msg">Tell us about your event</label>
          <textarea id="msg" name="message" rows="4" placeholder="Guest count, what you have in mind…"></textarea>
        </div>
        <button type="submit" class="btn btn--gold form__submit">
          Send request <span class="arrow" aria-hidden="true">→</span>
        </button>
        <p class="form__note" hidden data-note>Opening your email app with the details ready to send.</p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>(".contact__form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const to = form.dataset.email || "";
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) || "").trim();
    const subject = `Event enquiry: ${get("type")} (${get("name") || "New host"})`;
    const body = [
      `Name: ${get("name")}`,
      `Phone / WhatsApp: ${get("phone")}`,
      `Email: ${get("email") || "—"}`,
      `Event type: ${get("type")}`,
      `Preferred date: ${get("date") || "—"}`,
      "",
      "Details:",
      get("message") || "—",
    ].join("\n");
    const note = form.querySelector<HTMLElement>("[data-note]");
    if (note) note.hidden = false;
    window.location.href = `mailto:${to}?subject=${encodeURIComponent(
      subject
    )}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact {
    background:
      radial-gradient(110% 80% at 15% 0%, oklch(0.27 0.07 257) 0%, transparent 55%),
      var(--navy-950);
    color: var(--on-navy);
  }
  .contact__head {
    max-width: 52ch;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .contact__title {
    font-size: var(--step-4);
    margin-top: 1.1rem;
    color: var(--on-navy);
  }
  .contact__lede {
    margin-top: 1.1rem;
    color: var(--on-navy-soft);
    font-size: var(--step-1);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: start;
  }

  .contact__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }
  .contact__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    color: var(--on-navy-soft);
    line-height: 1.5;
  }
  .contact__ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--gold-400);
    border: 1px solid oklch(0.84 0.115 84 / 0.3);
    border-radius: 50%;
    flex: none;
  }
  .contact__ico svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .contact__label {
    display: block;
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin-bottom: 0.25rem;
    font-weight: 600;
  }
  .contact__list a:hover {
    color: var(--on-navy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact__quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 2rem 0;
  }

  .contact__map {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid oklch(0.84 0.115 84 / 0.22);
    box-shadow: var(--shadow-lift);
  }
  .contact__map iframe {
    width: 100%;
    height: clamp(15rem, 12rem + 8vw, 18rem);
    border: 0;
    display: block;
    filter: saturate(0.9);
  }

  /* form card — ivory focal point on navy */
  .contact__form {
    background: var(--ivory);
    color: var(--ink);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 1rem + 2vw, 2.6rem);
    box-shadow: var(--shadow-lift);
    display: grid;
    gap: 1.1rem;
  }
  .form__intro {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--ink);
    margin-bottom: 0.2rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    min-width: 0; /* let grid items shrink so inputs never overflow */
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .field label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
  }
  .field label span {
    font-weight: 400;
    color: var(--muted);
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.7rem 0.85rem;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  /* iOS gives date/time inputs a fixed intrinsic width; normalize so they
     fill the column and shrink with it instead of overflowing */
  .field input[type="date"],
  .field input[type="time"] {
    -webkit-appearance: none;
    appearance: none;
    box-sizing: border-box;
    height: calc(1.6em + 1.4rem + 2px); /* match text inputs' height */
  }
  .field input[type="date"]::-webkit-date-and-time-value {
    text-align: left;
  }
  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--gold-500);
    box-shadow: 0 0 0 3px oklch(0.84 0.115 84 / 0.28);
  }
  .form__submit {
    margin-top: 0.4rem;
    justify-self: start;
  }
  .form__note {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 880px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
