---
import Logo from "./Logo.astro";

const explore = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#occasions", label: "Occasions" },
  { href: "#gallery", label: "Gallery" },
  { href: "#contact", label: "Book a tour" },
];

// Replace # with the real social profiles when available.
const socials = [
  { label: "Instagram", href: "#", d: `<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>` },
  { label: "Facebook", href: "#", d: `<path d="M14 8.5h2.5M14 8.5C14 6.6 14.8 5.5 17 5.5M14 8.5V21M11 12h6M14 12v9"/>` },
  { label: "TikTok", href: "#", d: `<path d="M14 4c.4 2.6 2 4.2 4.6 4.4v2.7c-1.7 0-3.2-.5-4.6-1.5v5.9a5.1 5.1 0 1 1-5.1-5.1c.3 0 .6 0 .9.1v2.8a2.4 2.4 0 1 0 1.7 2.3V4Z"/>` },
];
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <Logo variant="dark" />
      <p class="footer__tag">
        Where every event feels Grand. A versatile event center in Achimota,
        Accra for the occasions that matter.
      </p>
      <ul class="footer__socials">
        {socials.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={s.d} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h3>Explore</h3>
      <ul>
        {explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h3>Reach us</h3>
      <ul>
        <li><a href="tel:+233245080252">+233 24 508 0252</a></li>
        <li><a href="mailto:hello@bigjaddyent.com">hello@bigjaddyent.com</a></li>
        <li>Achimota, Kingsby<br />Adjacent Hof Vilac Int. School</li>
      </ul>
    </div>
  </div>

  <div class="footer__word" aria-hidden="true">GRAND</div>

  <div class="footer__bar">
    <div class="wrap footer__bar-inner">
      <p>© {new Date().getFullYear()} BIG JADDY ENT. All rights reserved.</p>
      <p class="footer__parent">An arm of Big Jaddy Enterprise</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--navy-950);
    color: var(--on-navy-soft);
    overflow: hidden;
    padding-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    position: relative;
    z-index: 2;
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .footer__tag {
    margin-top: 1.4rem;
    max-width: 38ch;
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .footer__socials {
    list-style: none;
    padding: 0;
    margin-top: 1.8rem;
    display: flex;
    gap: 0.7rem;
  }
  .footer__socials a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid oklch(0.96 0.012 86 / 0.18);
    color: var(--on-navy-soft);
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.45s var(--ease-out);
  }
  .footer__socials svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .footer__socials a:hover {
    color: var(--navy-900);
    background: var(--gold-400);
    border-color: var(--gold-400);
    transform: translateY(-3px);
  }

  .footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin-bottom: 1.2rem;
    font-weight: 600;
  }
  .footer__col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .footer__col a {
    transition: color 0.25s ease;
  }
  .footer__col a:hover {
    color: var(--gold-400);
  }

  .footer__word {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 800;
    font-style: italic;
    text-align: center;
    line-height: 0.8;
    font-size: clamp(5rem, 1rem + 24vw, 22rem);
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px oklch(0.84 0.115 84 / 0.22);
    margin-bottom: -0.12em;
    user-select: none;
    pointer-events: none;
  }

  .footer__bar {
    border-top: 1px solid oklch(0.96 0.012 86 / 0.12);
    position: relative;
    z-index: 2;
    background: var(--navy-950);
  }
  .footer__bar-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.5rem;
    font-size: var(--step--1);
    color: var(--on-navy-soft);
  }
  .footer__parent {
    color: var(--gold-400);
    opacity: 0.85;
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 460px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
